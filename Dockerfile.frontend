FROM node:24-alpine AS deps

WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci

FROM node:24-alpine AS builder

WORKDIR /app/frontend
ENV NEXT_TELEMETRY_DISABLED=1
# The canonical host is the www one. NEXT_PUBLIC_* is baked in at build
# time, so a bare-host default here would ship a build whose canonical
# tags and sitemap point at the host that only 301-redirects.
ARG NEXT_PUBLIC_SITE_URL=https://www.reviss.app
ARG NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
ARG RECAPTCHA_SITE_KEY=
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_RECAPTCHA_SITE_KEY=$NEXT_PUBLIC_RECAPTCHA_SITE_KEY
ENV RECAPTCHA_SITE_KEY=$RECAPTCHA_SITE_KEY

COPY --from=deps /app/frontend/node_modules ./node_modules
COPY frontend ./
RUN npm run build

FROM node:24-alpine AS runner

WORKDIR /app/frontend
ARG NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
ARG RECAPTCHA_SITE_KEY=
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV NEXT_PUBLIC_RECAPTCHA_SITE_KEY=$NEXT_PUBLIC_RECAPTCHA_SITE_KEY
ENV RECAPTCHA_SITE_KEY=$RECAPTCHA_SITE_KEY

COPY --from=builder /app/frontend/public ./public
COPY --from=builder /app/frontend/.next/standalone ./
COPY --from=builder /app/frontend/.next/static ./.next/static

EXPOSE 3000
CMD ["node", "server.js"]
